# ChatKit — for docker-compose.yml, docker-compose.traefik.yml, docker-compose.dev.yml
# Copy to .env and fill in. Your Chatwoot URL and API token are NOT set here:
# you enter them in the builder under Settings after the first login.

# ─── Domain ───
# Must point (A record) at this server. Caddy gets the TLS certificate for it.
DOMAIN=chatkit.example.com

# ─── PocketBase superuser ───
# Created/updated on every start. Also your first login for the builder.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-this-to-a-long-random-password

# ─── Encryption key (strongly recommended) ───
# Encrypts the Chatwoot API token and CRM webhook secrets at rest (AES-256-GCM).
# The key stays on bot-service only. Generate: openssl rand -hex 32
# Set it BEFORE saving secrets in the builder. If unset, secrets are stored in
# plaintext. If you lose it, re-enter the secrets in the builder.
ENCRYPTION_KEY=

# ─── Webhook secret (recommended) ───
# Chatwoot agent-bot webhooks are not signed. When set, bot-service only accepts
# webhooks whose URL contains ?secret=<this value>. The builder adds it for you
# when it assigns a bot to an inbox. Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# ─── Optional ───
# Public URL Chatwoot calls for webhooks. Defaults to https://$DOMAIN
# BOT_SERVICE_URL=https://chatkit.example.com
# Pin a version instead of following :latest (tags are commit SHAs)
# CHATKIT_TAG=latest
# CHATKIT_IMAGE_PREFIX=ghcr.io/wannaco/chatkit
