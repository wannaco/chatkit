# ChatKit + Chatwoot — for docker-compose.full.yml
# Copy to .env and replace every CHANGE ME.

# ─── Domains (both A records → this server) ───
CHATWOOT_DOMAIN=chat.example.com
DOMAIN=chatkit.example.com

# ─── Chatwoot ───
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Pin a Chatwoot release for predictable upgrades, e.g. v4.1.0
CHATWOOT_VERSION=latest
# Leave false unless you want strangers to be able to create Chatwoot accounts
ENABLE_ACCOUNT_SIGNUP=false
# Outgoing email (password resets, agent invites). See Chatwoot's docs for all options.
MAILER_SENDER_EMAIL=Chatwoot <support@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# ─── ChatKit ───
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=CHANGE_ME
# Generate: openssl rand -hex 24
WEBHOOK_SECRET=CHANGE_ME
